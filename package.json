{
  "name": "dependable",
  "version": "0.1.0",
  "private": true,
  "description": "Tailwind build for the Dependable school management platform",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/app.css -o ./static/css/app.css --minify",
