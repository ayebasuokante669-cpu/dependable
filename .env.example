# Copy to .env and adjust.  .env is gitignored.

SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# --- Database -----------------------------------------------------------
# Leave DB_ENGINE unset for "Postgres if reachable, else SQLite".
# DB_ENGINE=postgres   # require Postgres, never fall back
# DB_ENGINE=sqlite     # always SQLite

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dependable

# ...or the discrete form instead of DATABASE_URL:
# DB_NAME=dependable
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# --- Public links -------------------------------------------------------
# Where this deployment answers from. Only mail needs it: an email has no
# request to resolve a relative path against, so the admissions enquiry
# reminder builds its link back to the school's public enquiry page from this.
# Left blank the link is omitted rather than sent broken.
# PUBLIC_BASE_URL=https://app.schoolcord.com

# --- Messaging ----------------------------------------------------------
# console (default) logs each message -- Sender ID included -- and marks it
# delivered, so the whole parent-messaging feature works with no credentials.
# Leave it EMPTY in production and each school sends through the gateway on its
# own messaging identity; set it to force every school onto one gateway.
# MESSAGING_PROVIDER=console

# There is no platform-wide sender ID. Each school's Sender ID lives on its
# SchoolMessagingConfig and is registered/approved under Messaging identity.

# Master gateway account. The platform pays for the units; schools send under
# their own Sender ID against it.
#
# Termii is the gateway: they support one account sending on behalf of many
# schools under each school's own Sender ID, which BulkSMS Nigeria declined to.
# TERMII_API_KEY=
# TERMII_BASE_URL=https://api.ng.termii.com

# Kept and still working, but no longer the default. Set
# MESSAGING_PROVIDER=bulksmsnigeria to move the whole platform back.
# BULKSMSNIGERIA_API_TOKEN=
# BULKSMSNIGERIA_DND=2

# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=

# --- Password policy ----------------------------------------------------
# New passwords are checked against Have I Been Pwned by k-anonymity: only the
# first five characters of the password's SHA-1 leave the server, never the
# password and never the full hash.
#
# On by default everywhere except under `manage.py test`. An unreachable API
# already fails open, so this is not the switch for a flaky network -- it is
# for turning the check off deliberately.
# PWNED_PASSWORDS_ENABLED=1
#
# Seconds to wait before giving up and falling through to the local
# validators. Keep it short: this sits inside the request that submits a
# signup or password-reset form.
# PWNED_PASSWORDS_TIMEOUT=1.5

# --- Production (Railway) -----------------------------------------------
# Set these in the Railway dashboard, not in a .env file -- there is no .env on
# the deployed container, and base.py's load_dotenv() simply finds nothing.
#
# Railway injects PORT and RAILWAY_PUBLIC_DOMAIN itself. Do not set either by
# hand: prod.py reads RAILWAY_PUBLIC_DOMAIN and appends it to ALLOWED_HOSTS and
# CSRF_TRUSTED_ORIGINS, so the generated *.up.railway.app address keeps working
# after the service is renamed or recreated.
#
# SECRET_KEY=<50+ random characters, not the dev value>
# DEBUG=False
# DB_ENGINE=postgres          # no SQLite fallback: a bad DATABASE_URL crashes
# DATABASE_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
# ALLOWED_HOSTS=theschoolcord.com,www.theschoolcord.com
# CSRF_TRUSTED_ORIGINS=https://theschoolcord.com,https://www.theschoolcord.com
# PUBLIC_BASE_URL=https://theschoolcord.com
# TIME_ZONE=Africa/Lagos
# MESSAGING_PROVIDER=console  # until the Termii Sender ID clears, then blank it
# WEB_CONCURRENCY=3           # gunicorn workers; lower on a small plan
#
# Password reset mail fails silently until these are set -- prod.py uses the
# SMTP backend unconditionally.
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=SCHOOLCORD <no-reply@theschoolcord.com>
