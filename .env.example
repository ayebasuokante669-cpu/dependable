# Copy to .env and adjust.  .env is gitignored.

SECRET_KEY=dev-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# --- Database -----------------------------------------------------------
# Leave DB_ENGINE unset for "Postgres if reachable, else SQLite".
# DB_ENGINE=postgres   # require Postgres, never fall back
# DB_ENGINE=sqlite     # always SQLite

DATABASE_URL=postgres://postgres:postgres@localhost:5432/dependable

# ...or the discrete form instead of DATABASE_URL:
# DB_NAME=dependable
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# --- Production only ----------------------------------------------------
# CSRF_TRUSTED_ORIGINS=https://app.dependable.example
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@dependable.example
